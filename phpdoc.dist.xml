<?xml version="1.0" encoding="UTF-8" ?>
<phpdocumentor
    configVersion="3"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://www.phpdoc.org/changes/ns/phpdoc"
    xsi:noNamespaceSchemaLocation="https://docs.phpdoc.org/latest/phpdoc.xsd"
>
    <title>GraphiCare - Documentação da API</title>

    <paths>
        <output>docs/api</output>
        <cache>/tmp/phpdoc-cache</cache>
    </paths>

    <version number="1.0.0">
        <api>
            <source dsn=".">
                <path>app</path>
            </source>
            <output>.</output>
            <ignore>
                <path>vendor/**/*</path>
                <path>tests/**/*</path>
                <path>storage/**/*</path>
                <path>bootstrap/**/*</path>
                <path>node_modules/**/*</path>
            </ignore>
            <extensions>
                <extension>php</extension>
            </extensions>
            <visibility>public</visibility>
            <visibility>protected</visibility>
            <visibility>private</visibility>
            <default-package-name>GraphiCare</default-package-name>
        </api>
    </version>
</phpdocumentor>
